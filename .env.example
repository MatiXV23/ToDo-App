# ─── App ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Zona horaria para fechas límite (ej. America/Argentina/Buenos_Aires). Vacío = la del servidor.
APP_TIMEZONE=

# ─── Base de datos ────────────────────────────────────────────────────
DATABASE_URL=postgres://todoapp:todoapp@localhost:5432/todoapp
DATABASE_URL_TEST=postgres://todoapp:todoapp@localhost:5432/todoapp_test

# ─── Autenticación ────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Login de desarrollo sin Google (usuarios de prueba). Se ignora siempre con NODE_ENV=production.
DEV_LOGIN_ENABLED=true

# ─── GitHub App ───────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Clave privada PEM: en una línea con \n, o codificada en base64.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# ─── IA ───────────────────────────────────────────────────────────────
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
