# ─── ToDoApp · producción ─────────────────────────────────────────────
# URL pública (con https). Debe coincidir con la redirección de Google OAuth.
APP_URL=https://todo.mperezfrontan.com
APP_TIMEZONE=America/Argentina/Buenos_Aires
WEB_PORT=3100

# Base de datos (el contenedor db la crea con estos datos)
POSTGRES_USER=todoapp
POSTGRES_PASSWORD=
POSTGRES_DB=todoapp

# openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub App (ver README)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# IA
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
